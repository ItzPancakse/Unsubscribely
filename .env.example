GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Google requires this value for installed-app token exchange. It is not confidential.
GOOGLE_CLIENT_SECRET=your-desktop-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# Azure stuff
AZURE_CLIENT_ID=
AZURE_REDIRECT_URI=http://localhost:3000/api/outlook/callback

# Optional for self-hosted confidential OAuth clients. Do not ship these in desktop builds.
AZURE_CLIENT_SECRET=
SESSION_SECRET=
