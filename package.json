{
  "name": "unsubscribely",
  "version": "1.0.0",
  "description": "My emails are too cluttered bro.",
  "homepage": "https://github.com/ItzPancakse/Unsubscribely#readme",
  "bugs": {
    "url": "https://github.com/ItzPancakse/Unsubscribely/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItzPancakse/Unsubscribely.git"
  },
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "server": "node server.js",
    "electron": "electron electron/main.js",
    "electron:dev": "npm run electron",
    "build": "vite build",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "dev.pancakse.unsubscribely",
    "productName": "Unsubscribely",
    "files": [
      "electron/**/*",
      "server.js",
      "*.html",
      "src/**/*",
      ".env",
      "package.json"
    ]
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@azure/msal-node": "^6.0.1",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "googleapis": "^181.0.0",
    "imapflow": "^2.0.5"
  }
}
